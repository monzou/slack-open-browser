{
  "manifest_version": 3,
  "name": "Slack Open in Browser",
  "version": "0.2.0",
  "description": "Open Slack links in the browser, not the app, by auto-clicking the \"use Slack in your browser\" link.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://*.slack.com/archives/*"],
      "run_at": "document_start"
    },
    {
      "js": ["highlight.js"],
      "css": ["highlight.css"],
      "matches": ["https://app.slack.com/client/*"],
      "run_at": "document_start"
    }
  ]
}
